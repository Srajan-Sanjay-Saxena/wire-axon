{
  "name": "zenith-api",
  "version": "1.0.0",
  "description": "Type-safe HTTP client with branded validation, request deduplication, retry with backoff, auth token refresh, and middleware pipeline. Built for TanStack Query + Redux Thunk.",
  "type": "module",
  "license": "MIT",
  "author": "Srajan Saxena",
  "keywords": [
    "api-client",
    "http-client",
    "tanstack-query",
    "react-query",
    "axios",
    "zod",
    "type-safe",
    "retry",
    "auth-refresh",
    "middleware",
    "request-cancellation",
    "branded-types"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc && tsc-alias",
    "prepublishOnly": "pnpm run build"
  },
  "types": "./JS/index.d.ts",
  "main": "./JS/index.js",
  "exports": {
    ".": {
      "types": "./JS/index.d.ts",
      "default": "./JS/index.js"
    },
    "./hooks/useQueryApiService": {
      "types": "./JS/hooks/useQueryApiService.d.ts",
      "default": "./JS/hooks/useQueryApiService.js"
    },
    "./hooks/useMutationApiService": {
      "types": "./JS/hooks/useMutationApiService.d.ts",
      "default": "./JS/hooks/useMutationApiService.js"
    },
    "./hooks/useScratchServiceQuery": {
      "types": "./JS/hooks/useScratchServiceQuery.d.ts",
      "default": "./JS/hooks/useScratchServiceQuery.js"
    },
    "./hooks/useScratchServiceMutation": {
      "types": "./JS/hooks/useScratchServiceMutation.d.ts",
      "default": "./JS/hooks/useScratchServiceMutation.js"
    }
  },
  "files": [
    "JS",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "axios": "^1.13.2",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "sonner": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.8",
    "react": "^19.1.0",
    "sonner": "^2.0.7",
    "tsc-alias": "^1.8.17"
  }
}
