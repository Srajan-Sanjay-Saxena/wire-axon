{
  "name": "wire-axon",
  "version": "1.1.0",
  "description": "Type-safe HTTP client with branded validation, request deduplication, retry with backoff, auth token refresh, and middleware pipeline. Built for TanStack Query + Redux Thunk.",
  "type": "module",
  "license": "MIT",
  "author": "Srajan Saxena",
  "keywords": [
    "api-client",
    "http-client",
    "tanstack-query",
    "react-query",
    "axios",
    "zod",
    "type-safe",
    "retry",
    "auth-refresh",
    "middleware",
    "request-cancellation",
    "branded-types"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc && tsc-alias",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    "./hooks": {
      "types": "./JS/hooks/index.d.ts",
      "default": "./JS/hooks/index.js"
    },
    "./services": {
      "types": "./JS/services/index.d.ts",
      "default": "./JS/services/index.js"
    },
    "./base": {
      "types": "./JS/base/index.d.ts",
      "default": "./JS/base/index.js"
    },
    "./features": {
      "types": "./JS/features/index.d.ts",
      "default": "./JS/features/index.js"
    },
    "./auth": {
      "types": "./JS/auth/index.d.ts",
      "default": "./JS/auth/index.js"
    },
    "./helper": {
      "types": "./JS/helper/index.d.ts",
      "default": "./JS/helper/index.js"
    },
    "./options": {
      "types": "./JS/options/index.d.ts",
      "default": "./JS/options/index.js"
    }
  },
  "files": [
    "JS",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "axios": "^1.13.2",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "sonner": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.8",
    "react": "^19.1.0",
    "sonner": "^2.0.7",
    "tsc-alias": "^1.8.17",
    "vitest": "^4.1.9"
  }
}
